# ──────────────────────────────────────────────
# LabTrack — Environment Configuration Template
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Django core
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Full URLs (with scheme and port) that are allowed to submit forms.
# Must include every origin users access the app from.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (MySQL)
# When DB_HOST is set, MySQL is used. Leave blank to use SQLite (dev only).
DB_NAME=labtrack
DB_USER=labtrack
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=3306
# Required when using docker-compose.mysql.yml (containerised MySQL).
MYSQL_ROOT_PASSWORD=changeme-root

# Redis (used by Celery for background tasks)
REDIS_URL=redis://redis:6379/0

# Email
# ── Option A: Gmail / external SMTP with auth ──
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=LabTrack <your-email@gmail.com>
#
# ── Option B: Campus relay (no auth, plain SMTP) ──
# EMAIL_HOST=mailrelay.auburn.edu
# EMAIL_PORT=25
# EMAIL_USE_TLS=False
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=shse@eng.auburn.edu
#
# ── Dev / no-email ──
# Leave EMAIL_HOST_USER and EMAIL_HOST_PASSWORD blank to print to console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_BACKEND=auto
DEFAULT_FROM_EMAIL=LabTrack <noreply@yourdomain.com>

# Full public URL of your deployment — used in email notification links.
SITE_URL=https://yourdomain.com

# Gunicorn tuning (optional)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# Nginx port (optional, default 80)
NGINX_PORT=80

# Timezone for the scheduler container (default UTC).
# Set to your local timezone so daily scheduled tasks run at the correct local time.
# Example: America/Chicago, America/New_York, Europe/London
TZ=America/Chicago

# Django log level (optional, default INFO)
DJANGO_LOG_LEVEL=INFO
